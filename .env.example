# Local development settings for the "dev" profile of auth-service, scenario-service, report-service and api-gateway.
# Copy this file to .env in the repository root and fill in the values. .env is gitignored: never commit it.
# All four services read this one file, so they share the same JWT secret.

# Shared HS512 signing secret: standard Base64 of at least 64 random bytes. Generate one with:
#   openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=

# Password of the local development database (the cucumber-postgres container, see auth-service/README.md).
# Any value without "${". Generate one with:
#   openssl rand -hex 24
AUTH_DB_PASSWORD=

# Password of the scenario_service role in the same local database container (see scenario-service/README.md).
# Any value without "${". Generate one with:
#   openssl rand -hex 24
SCENARIO_DB_PASSWORD=

# Password of the report_service role in the same local database container (see report-service/README.md).
# Any value without "${". Generate one with:
#   openssl rand -hex 24
REPORT_DB_PASSWORD=

# Key that report-service sends to auth-service's project status endpoint (X-Service-Key); auth-service and
# report-service must share it. Standard Base64 of at least 32 random bytes. Generate one with:
#   openssl rand -base64 32
# report-service needs it; auth-service answers /internal/service/** with 401 while it's empty.
INTERNAL_SERVICE_KEY=
